<%= turbo_stream.update "search-results" do %>
  <section class="search-results">
    <span><%= @products.size %> Results</span>
    <ol class="search-result-list">
      <% @products.each do |product| %>
        <%= render partial: "product", locals: {product:} %>
      <% end %>
    </ol>
  </section>
<% end %>